generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  //directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  clerkId   String   @unique
  role      String   @default("CANDIDAT") // "CANDIDAT" ou "RECRUTEUR"
  cv        Cv?
  emplois   Emploi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Favorite Favorite[]

  Candidature Candidature[]

  RecruterFavorite RecruterFavorite[]

  // Relations pour le système d'affiliation
  affiliateLink         AffiliateLink?
  referredSubscriptions AffiliateTransaction[] @relation("ReferredUser")
  subscription          Subscription?
}

model Cv {
  id             String          @id @default(uuid())
  clerkId         String          @unique
  fullName       String
  email          String
  phone          String
  linkedin       String?
  address        String
  postSeeking    String
  description    String
  photoUrl       String
  pdfUrl         String?
  user           User            @relation(fields: [clerkId], references: [clerkId])
  experiences    Experience[]
  educations     Education[]
  skills         Skill[]
  languages      Language[]
  hobbies        Hobby[]
  certifications Certification[]
  candidatures   Candidature[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  RecruterFavorite RecruterFavorite[]
}

model Experience {
  id          String   @id @default(uuid())
  cvId        String
  jobTitle    String
  companyName String
  startDate   DateTime
  endDate     DateTime
  description String?
  tasks       Task[]
  cv          Cv       @relation(fields: [cvId], references: [id],  onDelete: Cascade)
}

model Task {
  id           String     @id @default(uuid())
  experienceId String
  content      String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

model Education {
  id          String   @id @default(uuid())
  cvId        String
  degree      String
  school      String
  startDate   DateTime
  endDate     DateTime
  description String?
  cv          Cv       @relation(fields: [cvId], references: [id])
}

model Skill {
  id    String @id @default(uuid())
  cvId  String
  name  String
  level String
  cv    Cv     @relation(fields: [cvId], references: [id])
}

model Language {
  id          String @id @default(uuid())
  cvId        String
  name        String
  proficiency String
  cv          Cv     @relation(fields: [cvId], references: [id])
}

model Hobby {
  id   String @id @default(uuid())
  cvId String
  name String
  cv   Cv     @relation(fields: [cvId], references: [id])
}

model Certification {
  id   String @id @default(uuid())
  cvId String
  name String
  cv   Cv     @relation(fields: [cvId], references: [id])
}

//Model relatif à l'espace Recruteur

model Emploi {
  id            String   @id @default(uuid())
  jobTitle      String
  companyName   String
  locationJob   String
  typeJob       String
  description   String
  salary        String?
  datePublished DateTime @default(now())
  status        String   @default("En attente") // Statut de l'offre d'emploi

  clerkId       String
  user         User          @relation(fields: [clerkId], references: [clerkId])
  candidatures Candidature[]

  Favorite Favorite[]
}

model Candidature {
  id       String   @id @default(uuid())
  clerkId  String
  emploiId String
  status   String   @default("En attente") // Statut de la candidature

  user     User     @relation(fields: [clerkId], references: [clerkId])
  emploi   Emploi   @relation(fields: [emploiId], references: [id])
  cv       Cv?      @relation(fields: [clerkId], references: [clerkId], map: "Candidature_clerkId_cv_fkey")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id       String @id @default(uuid())
  clerkId   String
  emploiId String

  user     User   @relation(fields: [clerkId], references: [clerkId])
  emploi   Emploi @relation(fields: [emploiId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecruterFavorite {
  id          String   @id @default(uuid())
  clerkId     String
  candidateId String

  user        User     @relation(fields: [clerkId], references: [clerkId])
  candidate   Cv       @relation(fields: [candidateId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========================================
// SYSTÈME D'AFFILIATION
// ========================================

// Lien d'affiliation unique par candidat
model AffiliateLink {
  id            String   @id @default(uuid())
  code          String   @unique // Code unique (ex: "JOHN2024ABC")
  clerkId       String   @unique // Un seul lien par candidat
  user          User     @relation(fields: [clerkId], references: [clerkId])

  // Statistiques
  clicks        Int      @default(0) // Nombre de clics sur le lien
  conversions   Int      @default(0) // Nombre d'achats via le lien
  totalEarned   Float    @default(0) // Cashback total gagné (en FCFA)

  // Relations
  transactions  AffiliateTransaction[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Transaction d'affiliation (quand un filleul achète)
model AffiliateTransaction {
  id              String   @id @default(uuid())
  affiliateLinkId String
  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id])

  // Informations du filleul qui a acheté
  referredClerkId String
  referredUser    User   @relation("ReferredUser", fields: [referredClerkId], references: [clerkId])

  // Détails de la transaction
  subscriptionType String  // "CANDIDAT" ou "ENTREPRISE"
  amount           Float   // Montant payé par le filleul (en FCFA)
  commission       Float   // 10% du montant (en FCFA)
  status           String  @default("PENDING") // PENDING, PAID, CANCELLED

  // Métadonnées FedaPay
  fedapayTransactionId String? // ID de transaction FedaPay
  fedapayCustomerId    String? // ID client FedaPay

  createdAt        DateTime @default(now())
  paidAt           DateTime? // Date de paiement du cashback
}

// Abonnement Premium des utilisateurs
model Subscription {
  id          String   @id @default(uuid())
  clerkId     String   @unique
  user        User     @relation(fields: [clerkId], references: [clerkId])

  type        String   // "CANDIDAT" (3000 FCFA) ou "ENTREPRISE" (5000 FCFA)
  status      String   // "ACTIVE", "CANCELLED", "EXPIRED"
  price       Float    // Prix payé en FCFA

  startDate   DateTime @default(now())
  endDate     DateTime // Date d'expiration (startDate + 1 mois)

  // Tracking affiliation
  referredBy  String?  // Code d'affiliation utilisé lors de l'inscription

  // Métadonnées FedaPay
  fedapayTransactionId String? // ID de transaction FedaPay
  fedapayCustomerId    String? // ID client FedaPay

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}